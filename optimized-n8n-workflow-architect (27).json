        "otherOptions": {}
      },
      "id": "a1b2c3d4-0011-4000-8000-000000000000",
      "name": "Slack Error Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        320,
        700
      ]
    }
  ],
