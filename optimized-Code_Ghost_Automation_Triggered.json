      "id": "719e7578-df85-441c-8d2f-cb7d3f7bb92f",
      "name": "Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        700,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "try {\n  const input = $input.all()[0];\n  // Access the Agent output. LangChain nodes usually output text or an object based on parser.\n  // We expect a JSON object inside the output due to the parser.\n  const agentOutput = input.json.output;\n  \n  // Handle cases where agentOutput might be a stringified JSON or already an object\n  let data = agentOutput;\n  if (typeof agentOutput === 'string') {\n      try {\n          data = JSON.parse(agentOutput);\n      } catch (e) {\n          // If parsing fails, try finding JSON substring\n          const match = agentOutput.match(/\\{.*\\}/s);\n          if (match) data = JSON.parse(match[0]);\n      }\n  }\n\n  if (!data || !data.title || !data.content) {\n    throw new Error('LLM output missing required title or content fields');\n  }\n\n  // Sanitation\n  const title = data.title.trim();\n  let content = data.content.replace(/<h1>.*?<\\/h1>/s, '').trim(); // Remove duplicate H1 if present\n\n  return { \n    json: { \n      success: true, \n      title, \n      content \n    } \n  };\n\n} catch (error) {\n  return { \n    json: { \n      success: false, \n      error: error.message,\n      timestamp: new Date().toISOString()\n    } \n  };\n}"
      },
      "id": "5f16e695-3585-468f-8fcb-794f5e3b56d4",
      "name": "Validate & Format",
