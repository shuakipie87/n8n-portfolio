{
  "name": "## Form - Screaming Frog Upload",
  "nodes": [
    {
      "parameters": {
        "content": "## Form - Screaming Frog Upload\nTrigger the workflow by uploading your **internal_html.csv** or **internal_all.csv** export.\n\n**New:** Use the checkbox to enable AI filtering for better precision.",
        "height": 188,
        "width": 376,
        "color": 7
      },
