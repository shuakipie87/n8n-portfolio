        "jsCode": "const statusMap = {\n  lead_interested: \"Interested\",\n  lead_meeting_booked: \"Meeting Booked\",\n  reply_received: \"Replied\",\n  auto_reply_received: \"Auto Reply\",\n  negative_reply: \"Not Interested\",\n  lead_meeting_completed: \"Meeting Completed\",\n  campaign_completed_for_lead_without_reply: \"No Reply\",\n  campaign_started: \"Campaign Started\",\n  campaign_paused: \"Campaign Paused\",\n  campaign_completed: \"Campaign Completed\",\n  email_bounced: \"Bounced\",\n  email_open: \"Opened\",\n  email_reply: \"Replied\",\n};\n\nreturn $input.all().map(item => {\n  const body = item.json;\n\n  // Normalize email\n  const leadEmail = $input.first().json.body.lead_email || null;\n\n  // Normalize event type\n  const eventType = $input.first().json.body.event_type || null;\n\n  // Map status safely in plain JS\n  let mappedStatus = \"Unknown\";\n  if (eventType && statusMap.hasOwnProperty(eventType)) {\n    mappedStatus = statusMap[eventType];\n  } else if (eventType) {\n    mappedStatus = eventType;\n  }\n\n  const timestamp = body.timestamp_created || body.timestamp || new Date().toISOString();\n\n  return {\n    json: {\n      leadEmail,\n      eventType,\n      mappedStatus,\n      timestamp,\n      raw: body\n    }\n  };\n});\n"
