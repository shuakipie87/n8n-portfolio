    {
      "id": "8b1c4d2e-format-success",
      "name": "Format Success Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -100
      ],
      "parameters": {
        "jsCode": "const output = $input.first().json.output || $input.first().json.text || \"{}\";\nlet json = {};\ntry {\n  // Sanitize Markdown\n  const clean = output.replace(/```json/g, '').replace(/```/g, '').trim();\n  json = JSON.parse(clean);\n} catch (e) {\n  json = { text: output, source_data: null, warning: \"Parse failure\" };\n}\nreturn json;"
      }
    },
    {
      "id": "9c2d5e3f-format-error",
      "name": "Format Error Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        120
      ],
      "parameters": {
        "jsCode": "return {\n  error: true,\n  message: \"Agent Execution Failed\",\n  details: $input.first().error ? $input.first().error.message : \"Unknown Error\"\n};"
      }
    }
