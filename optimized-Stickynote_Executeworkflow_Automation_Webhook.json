      "id": "14da2e8b-check-status",
      "name": "Check Agent Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
