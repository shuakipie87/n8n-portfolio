            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-4890-1234-567890123456",
      "name": "Already Categorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        240
      ],
      "notes": "Skips posts that already have one of the target IDs to save AI tokens."
    },
    {
      "parameters": {
        "jsCode": "// Robust Cleaning of AI Output\nconst aiOutput = $json.output || $json.text || '';\n// Regex to find the first sequence of digits\nconst match = aiOutput.toString().match(/(\\d+)/);\n\nif (match) {\n  return {\n    json: {\n      ...$json,\n      cleanCategoryId: parseInt(match[0], 10)\n    }\n  };\n} else {\n  // Pass metadata to error handler logic if needed, or throw\n  throw new Error(`AI did not return a valid number. Output was: ${aiOutput}`);\n}"
      },
      "id": "c3d4e5f6-a7b8-4901-2345-678901234567",
      "name": "Validate & Parse ID",
