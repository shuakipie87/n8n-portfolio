    {
      "parameters": {
        "text": "=You are an expert content strategist. \n\nTask: Analyze the blog post title and assign the single most relevant Category ID from this list:\n\n13 = Content Creation\n14 = Digital Marketing\n15 = AI Tools\n17 = Automation & Integration\n18 = Productivity Tools\n19 = Analytics & Strategy\n\nTitle: \"{{ $json.title.rendered }}\"\n\nConstraint: Return ONLY the integer number of the category ID. Do not return any other text.",
        "options": {
          "systemMessage": "You are a classification machine. Output only numbers."
        },
        "promptType": "define"
      },
      "id": "dafeb935-532e-4067-9dfb-7e9a6bbc4e5a",
      "name": "AI Categorizer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
