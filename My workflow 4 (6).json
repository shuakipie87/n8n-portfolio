      "parameters": {
        "jsCode": "// Choose the timestamp you want to use\nconst item = items[0].json;\n\nconst endTimeStr = item.timestamp_last_reply; // ← Change this if needed\nif (!endTimeStr) {\n  throw new Error(\"timestamp_last_reply is missing in the lead data\");\n}\n\n// Buffer (defaults to 10 min if env missing)\nconst bufferMin = parseInt($env.WAIT_BUFFER_MINUTES || '10', 10);\n\n// Parse the date\nconst endDate = new Date(endTimeStr);\nif (isNaN(endDate.getTime())) {\n  throw new Error(\"Invalid timestamp format: \" + endTimeStr);\n}\n\n// Add buffer minutes\nconst waitDate = new Date(endDate.getTime() + bufferMin * 60 * 1000);\n\nreturn [{\n  json: {\n    waitUntil: waitDate.toISOString(),\n    originalEnd: endTimeStr,\n    leadId: item.id,\n    email: item.email,\n  }\n}];\n"
      },
