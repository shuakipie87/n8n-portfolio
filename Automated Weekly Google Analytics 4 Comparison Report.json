    {
      "parameters": {
        "jsCode": "// Access data from upstream nodes cleanly\nconst engagement = $('Process Engagement').first().json.engagement;\nconst search = $('Process Search').first().json.search;\nconst country = $('Process Country').first().json.country;\n\n// --- Helper Functions ---\nfunction generateTable(headers, rows, color) {\n    if(!rows || rows.length === 0) return '';\n    let table = `<table border=\"1\" style=\"border-collapse:collapse; width:100%; border:1px solid ${color}; font-family: Arial, sans-serif;\">`;\n    // Header\n    table += `<thead style=\"background-color:${color}; color:white;\"><tr>`;\n    headers.forEach(h => table += `<th style=\"padding:8px; text-align:left;\">${h}</th>`);\n    table += '</tr></thead><tbody>';\n    // Rows\n    rows.forEach(row => {\n        table += '<tr>';\n        row.forEach(cell => table += `<td style=\"padding:8px; border:1px solid #ddd;\">${cell}</td>`);\n        table += '</tr>';\n    });\n    table += '</tbody></table><br/>';\n    return table;\n}\n\nfunction sectionHeader(title, color) {\n    return `<h2 style=\"color:${color}; border-bottom: 2px solid ${color}; padding-bottom: 5px;\">${title}</h2>`;\n}\n\nfunction subHeader(title) {\n    return `<h3 style=\"color:#444;\">${title}</h3>`;\n}\n\nconst colors = {\n    engagement: '#4CAF50',\n    search: '#2196F3',\n    country: '#FF9800'\n};\n\nconst dateStr = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });\nlet html = `<h1 style=\"text-align:center; color:#333;\">Analytics Report: ${dateStr}</h1>`;\n\n// --- Engagement Section ---\nhtml += sectionHeader('Page Engagement', colors.engagement);\nhtml += subHeader('This Week');\nhtml += generateTable(['Page', 'Views', 'Users', 'Views/User', 'Events'], \n    engagement.thisWeek.map(i => [i.page, i.pageViews, i.activeUsers, i.viewsPerUser.toFixed(2), i.eventCount]), colors.engagement);\n\nhtml += subHeader('Prior Week');\nhtml += generateTable(['Page', 'Views', 'Users', 'Views/User', 'Events'], \n    engagement.priorWeek.map(i => [i.page, i.pageViews, i.activeUsers, i.viewsPerUser.toFixed(2), i.eventCount]), colors.engagement);\n\n// --- Search Section ---\nhtml += sectionHeader('Google Search Performance', colors.search);\nhtml += subHeader('This Week');\nhtml += generateTable(['Page', 'Users', 'Engaged', 'Eng. Rate', 'Pos', 'CTR', 'Clicks', 'Impr.'], \n    search.thisWeek.map(i => [i.page, i.activeUsers, i.engagedSessions, i.engagementRate.toFixed(2), i.avgPosition.toFixed(1), i.ctr.toFixed(2) + '%', i.clicks, i.impressions]), colors.search);\n\n// --- Country Section ---\nhtml += sectionHeader('Geographic Distribution', colors.country);\nhtml += subHeader('This Week');\nhtml += generateTable(['Country', 'Active Users', 'New Users', 'Eng. Rate', 'Total Users'], \n    country.thisWeek.map(i => [i.country, i.activeUsers, i.newUsers, i.engagementRate.toFixed(2), i.totalUsers]), colors.country);\n\nreturn {\n    json: {\n        title: `Analytics Report - ${dateStr}`,\n        html: html\n    }\n};"
      },
