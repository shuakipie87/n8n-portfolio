    {
      "parameters": {
        "options": {},
        "promptType": "define",
        "text": "=You are an expert content strategist. \n\nTask: Analyze the blog post title and assign the single most relevant Category ID from the list below.\n\nCategories:\n13 = Content Creation\n14 = Digital Marketing\n15 = AI Tools\n17 = Automation & Integration\n18 = Productivity Tools\n19 = Analytics & Strategy\n\nTitle: \"{{ $('Split In Batches').item.json.title.rendered }}\"\n\nCRITICAL: You must return ONLY a JSON object. Do not include markdown formatting or explanation.\nExample format: { \"category_id\": 13 }"
      },
      "id": "c3d4e5f6-a7b8-4901-2345-678901abcdef",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1140,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Robust Parsing to handle potential AI inconsistencies\nconst aiOutput = $input.item.json.output || '{}';\nlet categoryId = null;\n\ntry {\n  // Attempt to parse JSON directly\n  const parsed = JSON.parse(aiOutput);\n  categoryId = parsed.category_id || parsed.categoryId;\n} catch (e) {\n  // Fallback: Regex extraction if AI returned text with numbers\n  const match = aiOutput.match(/\\d+/);\n  if (match) categoryId = parseInt(match[0]);\n}\n\nif (!categoryId) {\n  throw new Error('AI failed to return a valid Category ID');\n}\n\nreturn {\n  json: {\n    original_id: $('Split In Batches').item.json.id,\n    new_category_id: categoryId\n  }\n};"
      },
      "id": "d4e5f6a7-b8c9-4012-3456-789012abcdef",
      "name": "Parse & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        220
      ]
    },
    {
      "parameters": {
        "postId": "={{ $json.original_id }}",
