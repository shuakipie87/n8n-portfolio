{
  "name": "Calendy Trigger to Instantly if Booked or Meeting Completed or Cancel",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Detect whether Calendly sent the normal wrapper (\"payload\") \n// or if n8n already parsed the inner object.\nconst payload = $json.payload || $json;\n\n// --- Tracking Information ---\nconst tracking = payload.tracking || {};\n\n// --- Core Invitee Information ---\nconst email = payload.email || null;\nconst Name = payload.name || null;\n\n// --- Event Timing ---\nconst startTime = payload.scheduled_event?.start_time || null;\nconst endTime = payload.scheduled_event?.end_time || null;\n\n// --- Cancellations, Reschedules, No-show ---\nconst canceled = payload.canceled || false;\nconst rescheduled = payload.rescheduled || false;\nconst noShow = payload.no_show ? true : false;\n\n// --- Event Name, Type, etc. ---\nconst eventName = payload.scheduled_event?.name || null;\nconst eventUri = payload.scheduled_event?.uri || null;\nconst eventType = payload.scheduled_event?.event_type || null;\n\n// --- Payment data (if any) ---\nconst payment = payload.payment || null;\n\n// --- Dynamic Instantly Lead Info ---\nconst lead = $json.lead?.[0]; // Assuming lead info is passed from previous node\nconst leadId = lead?.id || null;\n\n// Only create Instantly payload if lead exists and meeting is not canceled\nlet instantlyPayload = null;\nif (leadId && !canceled) {\n    instantlyPayload = {\n        method: \"POST\",\n        url: `https://api.instantly.ai/api/v1/leads/${leadId}/event`,\n        body: {\n            email,\n            event_type: \"lead_meeting_booked\"\n        },\n        headers: {\n            Authorization: \"Bearer ODkzZmRkNjUtNmUzYy00Njc4LTgzMWUtZTkxZDdlYWY1YzhjOnNuQWVQVWdoTlZ2aw==\",\n            \"Content-Type\": \"application/json\"\n        }\n    };\n}\n\n// --- Return the final object for next n8n node ---\nreturn {\n    json: {\n        email,\n        Name,\n        startTime,\n        endTime,\n        eventName,\n        eventUri,\n        eventType,\n        canceled,\n        rescheduled,\n        noShow,\n        payment,\n        leadId,\n        instantlyPayload\n    }\n};\n"
      },
      "id": "91d6e087-e5c4-4ab2-a6d4-d9d51955c612",
      "name": "Match Booking to Opportunity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -1296,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check if endTime exists\nif (!$json.endTime) {\n    return {\n        json: {\n            ...$json,\n            waitUntil: null,\n            error: \"endTime is missing\"\n        }\n    };\n}\n\n// Convert endTime string to a Date object\nconst endDate = new Date($json.endTime);\n\n// Validate that the date is correct\nif (isNaN(endDate.getTime())) {\n    return {\n        json: {\n            ...$json,\n            waitUntil: null,\n            error: \"Invalid endTime format\"\n        }\n    };\n}\n\n// Add 10 minutes buffer\nendDate.setMinutes(endDate.getMinutes() + 10);\n\n// Return original meeting data + new waitUntil field\nreturn {\n    json: {\n        ...$json,\n        waitUntil: endDate.toISOString()\n    }\n};\n"
      },
