    {
      "parameters": {
        "jsCode": "// Get meeting details from Calendly webhook\nconst meeting = $json;\n\n// Parse the meeting end time\nconst endTime = new Date(meeting.endTime);\n\n// Current time\nconst now = new Date();\n\n// Determine if meeting is completed\n// Conditions:\n// 1. Meeting is not canceled\n// 2. Meeting is not rescheduled\n// 3. Current time is after endTime\nconst completed = !meeting.canceled && !meeting.rescheduled && now > endTime;\n\n// Return original meeting data + 'completed' field\nreturn {\n    json: {\n        ...meeting,\n        completed\n    }\n};\n"
      },
