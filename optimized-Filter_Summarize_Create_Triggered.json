      "typeVersion": 3.4,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cef4feaa-1c46-45b1-92b7-f5c2051b1dc5",
              "leftValue": "={{ Number($json.statut) }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "rightValue": 200
            },
            {
              "id": "bb821656-9740-4da4-8aa9-f65ad098c470",
              "leftValue": "={{ [\"Indexable\", \"Indicizzabile\", \"Indexierbar\"].includes($json.indexability) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            },
            {
              "id": "5c93ddb8-8091-406a-bc04-fa14e8b73fb9",
              "leftValue": "={{ $json.content_type }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "rightValue": "text/html"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
