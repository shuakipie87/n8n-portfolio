{
  "nodes": [
    {
      "parameters": {
        "content": "## Form - Screaming Frog Upload\nTrigger the workflow by uploading your **internal_html.csv** or **internal_all.csv** export.\n\n**New:** Use the checkbox to enable AI filtering for better precision.",
        "height": 460,
        "width": 360,
        "color": 7
      },
      "id": "ca701618-b2d5-48ee-a503-d3513d018a65",
      "name": "Sticky Note - Form",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "options": {
          "buttonLabel": "Generate llms.txt"
        },
        "formTitle": "llms.txt Generator",
        "formDescription": "Generate an AI-ready llms.txt file from a Screaming Frog export.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Website Name",
              "placeholder": "e.g. My Awesome Site",
              "requiredField": true,
              "id": "1"
            },
            {
              "fieldLabel": "Short Description",
              "placeholder": "e.g. Documentation for our API",
              "requiredField": true,
              "id": "2"
            },
            {
              "fieldLabel": "Enable AI Filtering?",
              "fieldType": "boolean",
              "defaultValue": false,
              "id": "3",
              "requiredField": true
            },
            {
              "fieldLabel": "Screaming Frog Export (CSV)",
              "fieldType": "file",
              "acceptFileTypes": ".csv",
              "requiredField": true,
              "id": "4"
            }
          ]
        },
        "responseMode": "lastNode"
      },
      "id": "e33104af-802a-43f2-b26d-f368f7de2fd7",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
