          "categories": [
            {
              "category": "useful_content",
              "description": "Pages that are likely to contain high-quality content, suitable for LLM context."
            },
            {
              "category": "other_content",
              "description": "Pages to exclude (pagination, low-value, login pages)."
            }
          ]
        },
        "options": {}
      },
