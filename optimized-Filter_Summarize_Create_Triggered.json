    {
      "parameters": {
        "jsCode": "// Aggregate useful results from the classifier loop\n// 'Text Classifier' output index 0 corresponds to 'useful_content'\nconst items = $('Text Classifier').all(0, 0).map(i => i.json);\nreturn items;"
      },
      "id": "b23456c8-1234-4567-890a-bcdef1234567",
