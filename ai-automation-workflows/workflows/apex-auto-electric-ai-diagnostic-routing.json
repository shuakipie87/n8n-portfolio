      },
      "id": "91ece508-e1e3-45d6-a6cb-83d3fb7ce239",
      "name": "Receive Job Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -1536,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "  const rawJson = $input.first().json;                                                                                    const input = (rawJson && rawJson.body) ? rawJson.body : rawJson;                                                                                                                                                                               const required = ['vehicleModel', 'dtcCode', 'technicianObservations'];                                                 const missing = required.filter(field => {\n    const val = input[field];\n    return val === undefined || val === null || (typeof val === 'string' && val.trim() === '');\n  });\n\n  if (missing.length > 0) {\n    throw new Error('Missing required fields: vehicleModel, dtcCode, and technicianObservations are required');\n  }\n\n  return [\n    {\n      json: {\n        vehicleModel: String(input.vehicleModel).trim(),\n        dtcCode: String(input.dtcCode).trim(),\n        technicianObservations: String(input.technicianObservations).trim()\n      }\n    }\n  ];"
      },
      "id": "5913e49c-ea91-458d-85f2-95d1b81136e8",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1328,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"model\": \"claude-opus-4-6\",\n    \"max_tokens\": 16000,\n    \"messages\": [\n      {\n        \"role\": \"user\",\n        \"content\": \"{{ $json.technicianObservations }}\"\n      }\n    ],\n    \"system\": \"You are an automotive diagnostic expert. Analyze the DTC code and technician observations for a {{\n  $json.vehicleModel }} and provide a detailed diagnostic report.\"\n  }",
        "options": {}
      },
      "id": "7697a974-1204-458f-8bca-e1ae96d17036",
      "name": "AI Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -1104,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Retrieve original fields passed through from prior nodes\nconst vehicleModel = input.vehicleModel || '';\nconst dtcCode = input.dtcCode || '';\nconst technicianObservations = input.technicianObservations || '';\n\nconst timestamp = new Date().toISOString();\n\nlet category = 'Unknown';\nlet urgency = 3;\nlet confidence = 'low';\nlet summary = 'AI response could not be parsed; manual triage required.';\n\ntry {\n  const rawContent = input.choices[0].message.content;\n  // Strip markdown code fences if present\n  const cleaned = rawContent.replace(/```json\\s*/gi, '').replace(/```\\s*/gi, '').trim();\n  const parsed = JSON.parse(cleaned);\n\n  // Validate category\n  const validCategories = ['High-Voltage Battery', 'Charging Infrastructure', 'Infotainment/ADAs', 'Drivetrain', 'Unknown'];\n  if (typeof parsed.category === 'string' && validCategories.includes(parsed.category)) {\n    category = parsed.category;\n  }\n\n  // Validate urgency\n  const u = Number(parsed.urgency);\n  if (Number.isInteger(u) && u >= 1 && u <= 5) {\n    urgency = u;\n  }\n\n  // Validate confidence\n  if (parsed.confidence === 'high' || parsed.confidence === 'low') {\n    confidence = parsed.confidence;\n  }\n\n  // Validate summary\n  if (typeof parsed.summary === 'string' && parsed.summary.trim().length > 0) {\n    summary = parsed.summary.trim();\n  }\n} catch (err) {\n  // Parse failed \u2014 defaults already set to Unknown / low confidence\n}\n\nreturn [\n  {\n    json: {\n      vehicleModel,\n      dtcCode,\n      technicianObservations,\n      category,\n      urgency,\n      confidence,\n      summary,\n      timestamp\n    }\n  }\n];"
      },
      "id": "c1a021c8-8e5a-433b-9024-8d36d23ca955",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        400
      ]
    },
