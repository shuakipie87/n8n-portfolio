    {
      "parameters": {
        "jsCode": "// Compute daysUntilEnd for every contractor row.\n// Normalizes column names from either Google Sheets or Airtable shape.\n// Outputs one item per contractor with a deterministic schema.\n\nconst items = $input.all();\nconst out = [];\nconst now = new Date();\nconst todayUtc = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\n\nfor (const it of items) {\n  const j = it.json || {};\n  const fields = j.fields || j; // Airtable wraps in .fields, Sheets is flat\n\n  const name = fields.Name || fields.name || fields['Contractor Name'] || '';\n  const email = fields.Email || fields.email || '';\n  const role = fields.Role || fields.role || '';\n  const endDateRaw = fields.EndDate || fields.endDate || fields['End Date'] || '';\n  const hasHardwareRaw = fields.HasHardware ?? fields.hasHardware ?? fields['Has Hardware'] ?? false;\n  const hardwareDetails = fields.HardwareDetails || fields.hardwareDetails || '';\n  const slackUserId = fields.SlackUserId || fields.slackUserId || '';\n  const status = fields.Status || fields.status || 'active';\n\n  // Validate required fields\n  if (!name) {\n    out.push({ json: { _error: true, _reason: 'missing_name', raw: fields, daysUntilEnd: null } });\n    continue;\n  }\n  if (!email || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(email))) {\n    out.push({ json: { _error: true, _reason: 'missing_or_invalid_email', name, raw: fields, daysUntilEnd: null } });\n    continue;\n  }\n\n  // Parse end date (accept ISO YYYY-MM-DD)\n  const endDate = new Date(endDateRaw);\n  if (isNaN(endDate.getTime())) {\n    out.push({ json: { _error: true, _reason: 'malformed_date', name, email, endDateRaw, daysUntilEnd: null } });\n    continue;\n  }\n  const endDateUtc = new Date(Date.UTC(endDate.getUTCFullYear(), endDate.getUTCMonth(), endDate.getUTCDate()));\n  const daysUntilEnd = Math.round((endDateUtc.getTime() - todayUtc.getTime()) / (1000 * 60 * 60 * 24));\n\n  // Normalize hasHardware (TRUE/true/1/yes => true)\n  const hasHardware = /^(true|1|yes|y)$/i.test(String(hasHardwareRaw));\n\n  out.push({\n    json: {\n      name,\n      email,\n      role,\n      endDate: endDateUtc.toISOString().slice(0, 10),\n      daysUntilEnd,\n      hasHardware,\n      hardwareDetails,\n      slackUserId,\n      status,\n      _error: false\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "4aaf13c7-a225-4a76-b1ec-5821d453627d",
