        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ model: 'openai/gpt-4o-mini', temperature: 0.4, max_tokens: 600, messages: [{ role: 'system', content: 'You are an HR assistant at Pixel & Pillar, a Shopify development agency. Write a warm but professional final-day email checklist for an outgoing contractor. Keep it under 250 words. Use a clear bulleted checklist for: final time-log submission, knowledge transfer notes, repository handoff, hardware return (if applicable), final invoice. Personalize tone to their role. Plain text only, no markdown.' }, { role: 'user', content: 'Contractor name: ' + $json.name + '\\nRole: ' + $json.role + '\\nEnd date: ' + $json.endDate + '\\nHas company hardware: ' + ($json.hasHardware ? 'YES \u2014 ' + $json.hardwareDetails : 'no') }] }) }}",
