    {
      "parameters": {
        "jsCode": "// Merge AI checklist back onto contractor row so downstream Gmail can use both\nconst ai = $input.first().json;\nconst contractor = $('Switch - Offboarding Stage').item.json;\n\nlet checklist = '';\ntry {\n  checklist = ai.choices?.[0]?.message?.content || '';\n} catch (e) {\n  checklist = '';\n}\n\nif (!checklist || checklist.length < 20) {\n  // Fallback if AI fails so the email still goes out\n  checklist = `Hi ${contractor.name},\\n\\nToday is your final day with Pixel & Pillar. Please complete the following before EOD:\\n\\n- Submit your final time log\\n- Push any in-flight branches and add handoff notes to the project README\\n- Confirm repository access can be revoked\\n${contractor.hasHardware ? '- Coordinate hardware return: ' + contractor.hardwareDetails + '\\n' : ''}- Submit your final invoice\\n\\nThank you for your work on the team.\\n\\nPixel & Pillar HR`;\n}\n\nreturn [{\n  json: {\n    ...contractor,\n    personalizedChecklist: checklist\n  }\n}];"
      },
      "id": "dc8ac2f9-2ff8-48ac-9c3b-df34c3db1575",
      "name": "Code - Merge AI Checklist",
      "type": "n8n-nodes-base.code",
