    {
      "parameters": {
        "text": "={{ $('Chat Trigger').item.json.chatInput }}",
        "options": {
          "systemPromptTemplate": "You are an intelligent assistant for a shoe and accessories store.\n\n1. Analyze the input to check if the user is looking for a product.\n2. If looking for a product, extract keywords, price ranges, and SKU.\n3. Output a JSON with:\n   - search_intent: boolean\n   - search_params: { keyword, min_price, max_price, sku, category }\n"
        },
        "schemaType": "manual",
        "inputSchema": "{\n \"search_intent\": true,\n \"search_params\": {\n  \"keyword\": \"string\",\n  \"min_price\": \"number\",\n  \"max_price\": \"number\",\n  \"sku\": \"string\",\n  \"category\": \"string\"\n }\n}"
      },
