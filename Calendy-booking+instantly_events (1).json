    {
      "parameters": {
        "jsCode": "// Robust Date Calculation\nconst event = $('Trigger: Booking Created').item.json.payload.scheduled_event;\nconst endTimeStr = event.end_time;\n\nif (!endTimeStr) {\n  throw new Error(\"Event End Time missing from Calendly Payload\");\n}\n\nconst endDate = new Date(endTimeStr);\n// Add 15 minutes buffer to ensure meeting is definitely over\nendDate.setMinutes(endDate.getMinutes() + 15);\n\nreturn {\n  json: {\n    waitUntil: endDate.toISOString(),\n    inviteeUri: $('Trigger: Booking Created').item.json.payload.uri\n  }\n};"
      },
