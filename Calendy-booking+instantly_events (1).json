    {
      "parameters": {
        "jsCode": "// Get meeting details from Calendly webhook\nconst meeting = $json;\n\n// Parse the meeting end time\nconst endTime = new Date(meeting.endTime);\n\n// Current time\nconst now = new Date();\n\n// Determine if meeting is completed\nconst completed = !meeting.canceled && !meeting.rescheduled && now > endTime;\n\n// --- Extract Google Event ID if available ---\n// Use the join_url from scheduled_event.location\nlet googleEventId = null;\nconst joinUrl = meeting.scheduled_event?.location?.join_url || null;\n\nif (joinUrl) {\n    try {\n        const urlParams = new URLSearchParams(joinUrl.split('?')[1]);\n        googleEventId = urlParams.get('event'); // extract 'event' query param\n    } catch (err) {\n        googleEventId = null;\n    }\n}\n\n// Return original meeting data + 'completed' field + Google Event ID\nreturn {\n    json: {\n        ...meeting,\n        completed,\n        googleEventId,\n        joinUrl // optional: include the full Google Meet URL for reference\n    }\n};\n"
      },
