    {
      "parameters": {
        "jsCode": "// Detect whether Calendly sent the normal wrapper (\"payload\") \n// or if n8n already parsed the inner object.\nconst payload = $json.payload || $json;\n\n// --- Tracking Information ---\nconst tracking = payload.tracking || {};\n\n\n// --- Core Invitee Information ---\nconst email = payload.email || null;\nconst Name = payload.name|| null;\n\n\n// --- Event Timing ---\nconst startTime = payload.scheduled_event?.start_time || null;\nconst endTime = payload.scheduled_event?.end_time || null;\n\n// --- Cancellations, Reschedules, No-show ---\nconst canceled = payload.status || false;\nconst rescheduled = payload.rescheduled || false;\nconst noShow = payload.no_show ? true : false;\n\n// --- Event Name, Type, etc. ---\nconst eventName = payload.scheduled_event?.name || null;\nconst eventUri = payload.scheduled_event?.uri || null;\nconst eventType = payload.scheduled_event?.event_type || null;\n\n// --- Payment data (if any) ---\nconst payment = payload.payment || null;\n\n// --- The final object returned to the next n8n node ---\nreturn {\n\tjson: {\n\t\n\t\temail,\n\t\tName,\t\t\n\t\tstartTime,\n\t\tendTime,\n\t\teventName,\n\t\teventUri,\n\t\teventType,\n\t\tcanceled,\n\t\trescheduled,\n\t\tnoShow,\n\t\tpayment\n\t}\n};\n"
      },
