    "Get Short Details": [
      {
        "json": {
          "id": "HZeTYwGiUt9A",
          "author_id": "5fa526d8-1d97-4ade-9870-5a6afdb1416f",
          "folder_id": "i6u7sU4S",
          "name": "Machine-gun approach: launch fast, iterate, and win by taking many shots",
          "created_at": "2025-11-27T16:38:57.418+00:00",
          "updated_at": "2025-11-27T16:38:57.418+00:00",
          "virality_score": 84,
          "virality_score_explanation": "Punchy 29s hook with a memorable metaphor (machine-gun vs sniper), clear actionable mindset and high shareability for founders/creators. Very replayable and easy to pair with quick visuals; loses a few points for limited mainstream appeal and lack of a standout anecdote or emotional peak.",
          "publication_captions": {
            "tiktok": "Ready to fire? 🎯 Embrace the machine-gun approach! 💥 What’s your next shot? #LaunchFast #Iterate",
            "youtube": "Ready to unleash your creativity? 💥 Let’s talk the machine-gun approach! 🚀 #LaunchFast #Iterate",
            "linkedin": "Ready to fire up your ideas? 💥 Launch fast, iterate, and win! What's your next shot? 🎯 #MachineGunMindset",
            "instagram": "Ready to fire? 🎯 Launch fast, iterate faster! 💥 What's your next shot? #MachineGunMindset"
          },
          "transcript_text": "I call this the machine gun approach. Build fast, release often, and treat every single app like a small experiment. Most people try to take like a sniper shot. One big idea, months or years of work, betting everything on a single shot, a single release. And then when it fails, game over. But the machine gun approach flips that logic around. You take lots of shots on the target and most will miss."
        }
      },
      {
        "json": {
          "id": "AzH0ZqXn8Wbi",
          "author_id": "5fa526d8-1d97-4ade-9870-5a6afdb1416f",
          "folder_id": "i6u7sU4S",
          "name": "How I turned one app into many — reuse code modules to multiply downloads and make $800K",
          "created_at": "2025-11-27T16:39:05.555+00:00",
          "updated_at": "2025-11-27T16:39:05.555+00:00",
          "virality_score": 92,
          "virality_score_explanation": "Strong viral potential — tight 35s runtime with a big hook (’make $800K’), actionable and repeatable tip (reuse code modules), and hot trends (Google Gemini/AI) plus nostalgia/emo triggers (Pokemon/Yu-Gi-Oh/’remove my ex’). Very shareable to makers and broader audiences intrigued by quick money/AI hacks. Slight downside: a bit technical and would rely on compelling visuals/demos to reach mainstream viral peaks.",
          "publication_captions": {
            "tiktok": "💡 From one app to many! How did I make $800K? 🤔 Let’s talk code magic! 🪄 #AppDevelopment #TechHacks",
            "youtube": "💰 From 1 app to $$$! How do you multiply your ideas? 🤔 #AppMagic #CodeHacks",
            "linkedin": "💡 Ever thought one app could lead to many? 🤔 Check out my $800K journey! 💰 #AppSuccess #CodeMagic",
            "instagram": "💡 Ever wondered how to multiply your app downloads? 🤔 Check out my $800K secret! 💰 #AppHacks #CodeMagic"
          },
          "transcript_text": "I also created a fish identifier and insect identifier. And for my Pokemon card scanner app, I spun it up into a Yu-Gi-Oh card scanner and a Star Wars unlimited card scanner app. And then for my remove my ex app, this was an app that uses Google Gemini to remove people from photos. I spun this up into a cartoon yourself app and an app that turns your drawings into photos. All three of these use the exact same code to interact with Google Gemini and a lot of the framework that I built for the apps themselves. They just needed a few tweaks."
        }
      }
